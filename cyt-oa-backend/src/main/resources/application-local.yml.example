# 复制为 application-local.yml 后按自己的环境填写；该文件已被 .gitignore 排除，不要提交真实口令。
spring:
  datasource:
    password: 你的本机 MySQL 口令

cyt:
  auth:
    # 本机才允许账号密码登录，默认管理员 admin / admin123（见 db/system-seed.sql）
    password-login-enabled: true
    # 本机才允许前端用 X-User-Id 头指定身份，接上登录态后请关闭
    dev-identity-enabled: true
    # 通讯录同步后自动获得 admin 角色的企微 userid，逗号分隔
    admin-userids: zhangwei
  wecom:
    # 企微一律经 CYT-Common 网关中转，本服务不持有企微密钥；Common 后端固定 8189
    gateway-url: http://127.0.0.1:8189
    # Common 后台「调用方系统 oa」签发的 API Key
    api-key: 你的网关调用密钥
    # 调用方身份必须与 Common 里注册的系统一致
    system-id: oa
    # 只有网关自身开启 GATEWAY_DEV_MODE=true 时才能免密钥直连，默认关闭
    allow-dev-identity: false
    # 请假提交的模板别名，需先在 Common 后台把企微请假模板 bind 成它
    leave-template: leave
  web:
    allowed-origins: http://localhost:80,http://127.0.0.1:80
  portal:
    # 培训资料 NAS MinIO：本机联调时指向公司 NAS；不配（留空）则媒体/导入端点回 503
    nas-minio:
      endpoint: http://192.168.1.248:9000
      access-key: 你的 NAS MinIO AccessKey
      secret-key: 你的 NAS MinIO SecretKey
      bucket: cyt-training
      region: us-east-1

logging:
  level:
    com.cyt.center: debug
