<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.2</version>
        <relativePath/>
    </parent>

    <groupId>com.cyt</groupId>
    <artifactId>cyt-oa-backend</artifactId>
    <version>1.0.0</version>
    <name>cyt-oa-backend</name>
    <description>个人中心后端：只写自己的业务代码，通用能力交给 Spring Boot 官方 starter</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <sa-token.version>1.46.0</sa-token.version>
        <!-- 以下版本对齐旧单体的 pom.xml 配置。
             MyBatis-Plus 不能退回 3.5.6：移植代码大量调用 BaseMapper 的 selectByIds / deleteByIds / insertOrUpdate，
             这三个默认方法分别是 3.5.9、3.5.9、3.5.7 才加的；mybatis-plus-join 1.5.9 也正好要求 3.5.17 -->
        <hutool.version>5.8.48</hutool.version>
        <guava.version>33.7.2-jre</guava.version>
        <commons-lang3.version>3.21.0</commons-lang3.version>
        <fesod.version>2.1.0-incubating</fesod.version>
        <mybatis-plus-join.version>1.5.9</mybatis-plus-join.version>
        <jsoup.version>1.23.2</jsoup.version>
        <redisson.version>4.8.0</redisson.version>
        <!-- Redisson 4.8 编译期对齐 netty 4.2（netty-bom 4.2.18），Boot 3.3.2 管理的是 4.1；
             本项目里 netty 只服务 Redis 客户端（Lettuce 已排除），提版本不影响 Web 层 -->
        <netty.version>4.2.18.Final</netty.version>
        <!-- Boot 3.3.2 管理的是 3.1.8，本地仓库只有 3.2.4，显式覆盖 -->
        <caffeine.version>3.2.4</caffeine.version>
        <springdoc.version>2.6.0</springdoc.version>
        <warm-flow.version>1.8.9</warm-flow.version>
        <!-- MinIO Java SDK：培训资料 NAS 桶的预签名与目录列举（同步阻塞，探图读头走线程池并发） -->
        <minio.version>8.5.17</minio.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- 3.5.9 起 JSqlParser 相关的内联拦截器（分页、块攻击防护等）被拆成独立模块，
             PaginationInnerInterceptor 就在这个包里 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- 登录态与权限校验：与网盘同族技术选型，前后台可用 device 区分 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!-- 联表查询：移植的 BaseMapperX / MPJLambdaWrapperX 依赖 MPJBaseMapper、MPJLambdaWrapper -->
        <dependency>
            <groupId>com.github.yulichang</groupId>
            <artifactId>mybatis-plus-join-boot-starter</artifactId>
            <version>${mybatis-plus-join.version}</version>
        </dependency>
        <!-- 通用工具：framework 与移植过来的模块代码大量使用 hutool / guava / commons-lang3 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>
        <!-- Excel 读写：EasyExcel 的 Apache 后继 Fesod，自带 poi / poi-ooxml -->
        <dependency>
            <groupId>org.apache.fesod</groupId>
            <artifactId>fesod-sheet</artifactId>
            <version>${fesod.version}</version>
        </dependency>
        <!-- HTML 解析：移植的社保标准数据 Service 从第三方页面抓取参保类型与缴费基数表格，版本对齐旧单体 -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>
        <!-- PDF 导出：工作汇报导出 PDF，本地仓库已具备 3.0.8（离线构建可用） -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
        </dependency>
        <!-- NAS MinIO 客户端：培训资料桶的预签名 / 目录列举 / 文件头读取 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>${minio.version}</version>
        </dependency>
        <!-- 本地缓存：移植的 @Cacheable 只缓存外部门市抓取的社保标准数据，
             用 Caffeine 进程内缓存即可（单实例部署，缓存允许各实例各存一份） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
        </dependency>
        <!-- Redis：移植代码里 OA 单号自增走 StringRedisTemplate、社保月表变更锁走 Redisson 分布式锁，
             连接工厂由 Redisson 提供，因此排除 Lettuce（同旧单体的做法） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.lettuce</groupId>
                    <artifactId>lettuce-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>${redisson.version}</version>
            <exclusions>
                <exclusion>
                    <!-- starter 默认带 redisson-spring-data-41（适配 Spring Data Redis 4.x），
                         本项目 Boot 3.3.2 对应 3.3，换成下方 spring-data-33 -->
                    <groupId>org.redisson</groupId>
                    <artifactId>redisson-spring-data-41</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.redisson</groupId>
                    <artifactId>redisson-spring-data-35</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-data-33</artifactId>
            <version>${redisson.version}</version>
        </dependency>
        <!-- 审批流引擎：轻量、表少、支持 JSON 流程定义。
             只引引擎和 JSON 插件，不引 warm-flow-plugin-ui-sb-web / warm-flow-plugin-vue3-ui：
             设计器端点允许直接写入含 SpEL 的流程定义，等于把表达式执行权交给前端，本项目流程定义由代码持有 -->
        <dependency>
            <groupId>org.dromara.warm</groupId>
            <artifactId>warm-flow-mybatis-plus-sb3-starter</artifactId>
            <version>${warm-flow.version}</version>
        </dependency>
        <dependency>
            <groupId>org.dromara.warm</groupId>
            <artifactId>warm-flow-plugin-json-v1</artifactId>
            <version>${warm-flow.version}</version>
        </dependency>
        <!-- OpenAPI 注解：移植的 PageParam 与模块 VO 上的 @Schema/@Operation 需要 io.swagger.v3 注解 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
