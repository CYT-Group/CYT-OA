# CYT-OA 前端镜像：Vite 构建 dist → nginx 托管，并把 /api 与 /admin-api 反代到 api 容器。
# build context 必须是【仓库根目录】：
#   docker build -f deploy/test-server/Dockerfile.web -t 192.168.1.182:5000/cyt-oa-web:latest .
FROM node:22-alpine AS build
WORKDIR /build
COPY cyt-oa-frontend/package.json cyt-oa-frontend/package-lock.json ./
ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN npm ci --registry="${NPM_REGISTRY}" --no-audit --no-fund
COPY cyt-oa-frontend/ ./
RUN npm run build

FROM docker.m.daocloud.io/library/nginx:alpine
COPY deploy/test-server/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist/ /usr/share/nginx/html/
EXPOSE 80
