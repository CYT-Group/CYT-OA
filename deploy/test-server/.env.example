# 复制为 /opt/1panel/docker/compose/oa/.env 后填真实口令（chmod 600，不入库）
OA_WEB_PORT=8091
OA_API_PORT=8092

OA_API_IMAGE=192.168.1.182:5000/cyt-oa-api:latest
OA_WEB_IMAGE=192.168.1.182:5000/cyt-oa-web:latest

POSTGRES_DB=cyt_oa_center
POSTGRES_USER=cyt_oa
POSTGRES_PASSWORD=CHANGE_ME

# 企微审批模板：配置 OA 容器能访问的 Common 网关地址和网关后台为 OA 签发的 API Key。
# 留空则企微功能不可用；地址不能照搬本机的 127.0.0.1（容器内指向 OA 容器自身）。
# 当前测试服 Common Java 为 http://192.168.1.182:8088（宿主机发布端口，容器内为 8189）。
CYT_WECOM_GATEWAY_URL=
CYT_WECOM_API_KEY=
CYT_WECOM_SYSTEM_ID=oa
CYT_WECOM_CORP_ID=
